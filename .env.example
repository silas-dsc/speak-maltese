# ── Tutor (required for conversation; drills work without it) ───────────────
ANTHROPIC_API_KEY=
SM_TUTOR_MODEL=claude-opus-5

# …or any OpenAI-compatible endpoint instead (Ollama, LM Studio, OpenRouter).
# No API key is needed for a local server.
#
# Free + local, measured best for Maltese (see README). Pull it first with:
#   ollama pull hf.co/bartowski/EuroLLM-9B-Instruct-GGUF:Q4_K_M
# SM_OPENAI_BASE_URL=http://localhost:11434/v1
# SM_OPENAI_MODEL=hf.co/bartowski/EuroLLM-9B-Instruct-GGUF:Q4_K_M
#
# Check any model before trusting it with your practice:
#   python scripts/check_tutor_model.py --base-url http://localhost:11434/v1 \
#          --model <name> --trials 4
# OPENAI_API_KEY=

# ── Text to speech ─────────────────────────────────────────────────────────
# Works out of the box with no key: edge-tts serves the same mt-MT-GraceNeural /
# mt-MT-JosephNeural voices. Add an Azure key for the official, supported path.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
SM_AZURE_VOICE=mt-MT-GraceNeural
SM_AZURE_VOICE_ALT=mt-MT-JosephNeural
# SM_TTS_PROVIDER=auto        # auto | azure | edge | elevenlabs | mms

# ── Speech to text ─────────────────────────────────────────────────────────
# OPENAI_API_KEY above also powers Whisper STT (Maltese is supported).
# ELEVENLABS_KEY=
# SM_ELEVENLABS_VOICE=
# SM_STT_PROVIDER=auto        # auto | openai_whisper | elevenlabs | faster_whisper | azure
SM_WHISPER_MODEL=small        # tiny|base|small|medium|large-v3 — local fallback
SM_WHISPER_DEVICE=auto        # auto | cpu | cuda

# ── Learning ───────────────────────────────────────────────────────────────
SM_DAILY_NEW=12
SM_DAILY_REVIEWS=150
SM_TARGET_RETENTION=0.9

# ── Server ─────────────────────────────────────────────────────────────────
SM_HOST=127.0.0.1
SM_PORT=8137
SM_DEBUG=0
