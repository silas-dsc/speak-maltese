# ── Tutor (required for conversation; drills work without it) ───────────────
ANTHROPIC_API_KEY=
SM_TUTOR_MODEL=claude-opus-5

# …or any OpenAI-compatible endpoint instead (Ollama, LM Studio, OpenRouter).
# No API key is needed for a local server.
#
# Free + local, measured best for Maltese (see README). Pull it first with:
#   ollama pull hf.co/bartowski/EuroLLM-9B-Instruct-GGUF:Q4_K_M
# SM_OPENAI_BASE_URL=http://localhost:11434/v1
# SM_OPENAI_MODEL=hf.co/bartowski/EuroLLM-9B-Instruct-GGUF:Q4_K_M
#
# Check any model before trusting it with your practice:
#   python scripts/check_tutor_model.py --base-url http://localhost:11434/v1 \
#          --model <name> --trials 4
# OPENAI_API_KEY=

# ── Text to speech ─────────────────────────────────────────────────────────
# Works out of the box with no key: edge-tts serves the same mt-MT-GraceNeural /
# mt-MT-JosephNeural voices. Add an Azure key for the official, supported path.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
SM_AZURE_VOICE=mt-MT-GraceNeural
SM_AZURE_VOICE_ALT=mt-MT-JosephNeural
# SM_TTS_PROVIDER=auto        # auto | azure | edge | elevenlabs | mms

# ── Speech to text ─────────────────────────────────────────────────────────
# Default is a Maltese wav2vec2 CTC model, which runs on Apple Silicon's GPU.
# It measures identical to the Maltese Whisper fine-tune (5.3% fWER, 96% pass)
# and is ~30x faster: ~0.3s an utterance against ~8.9s. The reason is structural
# — CTC is one forward pass over the audio you actually recorded, while Whisper
# decodes autoregressively and pads every input to a fixed 30-second window.
SM_W2V_MODEL=carlosdanielhernandezmena/wav2vec2-large-xlsr-53-maltese-64h
SM_W2V_DEVICE=auto            # auto | mps | cpu | cuda
# OPENAI_API_KEY above also powers Whisper STT (Maltese is supported).
# ELEVENLABS_KEY=
# SM_ELEVENLABS_VOICE=
# SM_STT_PROVIDER=auto        # auto | openai_whisper | elevenlabs | faster_whisper | azure
# Local fallback STT. Either a plain Whisper size (tiny|base|small|medium|large-v3)
# or any CTranslate2 model on the Hub.
#
# Default is a Maltese fine-tune of Whisper-large (64h Maltese, CC-BY-4.0). On 25
# clips it passed 96% of utterances against generic `small`'s 4% — generic Whisper
# does not merely mis-hear Maltese, it hallucinates.
#
# The cost is real: ~3 GB on first run, and ~9s to transcribe each thing you say on
# CPU (vs ~3s for `small`). The model is warmed at startup so the first utterance is
# no slower than the tenth. If that pause bothers you, the fix is a cloud recogniser,
# not a smaller local one — set OPENAI_API_KEY above and the chain prefers Whisper
# API automatically. Dropping to `small` just makes it fast and wrong.
SM_WHISPER_MODEL=carlosdanielhernandezmena/whisper-large-maltese-8k-steps-64h-ct2
# SM_WHISPER_MODEL=small
SM_WHISPER_DEVICE=auto        # auto | cpu | cuda

# ── Learning ───────────────────────────────────────────────────────────────
SM_DAILY_NEW=12
SM_DAILY_REVIEWS=150
SM_TARGET_RETENTION=0.9

# ── Server ─────────────────────────────────────────────────────────────────
SM_HOST=127.0.0.1
SM_PORT=8137
SM_DEBUG=0
