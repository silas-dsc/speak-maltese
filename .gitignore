# Browser copies of the recogniser — hundreds of megabytes, and GitHub refuses
# single files over 100MB. Rebuild with scripts/export_onnx_web.py, or host them
# somewhere with a CDN and point localstt.js at it.
web/models/

# Build output. `python scripts/build_static.py` regenerates it, and CI builds its
# own copy — committing it would double every audio file in the repo.
dist/

# Credentials. Never commit — this repo is public.
.hf-token
*.token
