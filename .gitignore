.venv/
__pycache__/
*.pyc
.env
data/progress.db
data/progress.db-wal
data/progress.db-shm
# The rendered speech is committed, not ignored. It is 25MB across 1584 files,
# which is a lot for a repo — but the static build has no server to synthesise on
# demand, and rebuilding it depends on an unofficial Edge endpoint that can vanish
# without notice. Losing it would mean an app that cannot speak.
# data/audio_cache/
data/frequency_import.tsv
.DS_Store
data/eval_clips/

# Distillation working set: precomputed mel features, teacher posteriors and student
# checkpoints. Hundreds of megabytes, and all of it regenerated by
# `scripts/distill_stt.py teacher` from the audio cache.
data/distill/

# Training audio pulled or rendered rather than authored. Gigabytes, and reproducible:
# FLEURS by "distill_stt.py teacher --sources real", the accented renders by
# "render_accents.py". Neither belongs in a repository whose point is a 2.1MB model.
data/fleurs/
data/accents/
models/
data/corpus_phrases.tsv
data/.corpus_cache/

# Browser copies of the 200MB wav2vec2 recogniser — hundreds of megabytes, and
# GitHub refuses single files over 100MB. The app ships a 2.1MB model in
# frontend/stt/ instead and no longer loads these; scripts/export_onnx_web.py and
# scripts/bench_onnx.py remain as the measurement that decided it.
web/models/

# Build output. `python scripts/build_static.py` regenerates it, and CI builds its
# own copy — committing it would double every audio file in the repo.
dist/

# Credentials. Never commit — this repo is public.
.hf-token
*.token

# 7.5GB of downloaded training corpora — re-fetchable by the import scripts, and
# MASRI-SYNTHETIC is CC-BY-NC-SA, which is not something to vendor into a public repo.
data/corpora/
